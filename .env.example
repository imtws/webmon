# =============================================
# WebMon — .env.example
# cp .env.example .env 후 값 입력
# =============================================

# --- MariaDB ---
DB_HOST=db
DB_PORT=3306
DB_NAME=sitemonitor
DB_USER=sitemonitor
DB_PASS=your_secure_password_here
DB_ROOT_PASS=your_root_password_here

# --- PHP / Apache ---
PHP_TIMEZONE=Asia/Seoul
APP_DEBUG=false

# --- 텔레그램 알림 ---
TG_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=your_telegram_chat_id_here

# --- 이메일 (선택, 기본은 수신 서버로 직접 발송) ---
ALERT_EMAIL=alert@yourdomain.com
# Direct delivery requires outbound TCP port 25 and valid sender-domain DNS policy.
# To use an authenticated relay later, configure RELAYHOST and its credentials in docker-compose.yml.

# --- 대시보드 URL (알림 메시지에 포함) ---
WEBMON_URL=http://your-server-ip:8080

# --- 스케줄 (cron 표현식) ---
SCHEDULE_ALERT=* * * * *       # 매 1분: 키워드 감지
SCHEDULE_ASSET=0 1 * * *       # 매일 새벽 1시: SSL/도메인 만료일 갱신
SCHEDULE_REPORT=0 9 * * 1      # 매주 월요일 9시: 주간 만료 리포트

# --- 튜닝 (선택) ---
ALERT_CONCURRENCY=60           # 동시 체크 상한 (기본 60)
